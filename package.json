{
  "name": "youyou-toolkit",
  "version": "1.0.222",
  "description": "YouYou工具箱 - SillyTavern工具插件，支持API连接、预设管理与正则提取",
  "main": "index.js",
  "type": "module",
  "scripts": {
    "build": "node esbuild.config.js build",
    "build:dev": "node esbuild.config.js dev",
    "build:iife": "node esbuild.config.js iife",
    "watch": "esbuild index.js --bundle --format=esm --outfile=dist/bundle.js --watch --loader:.css=text",
    "dev": "npm run build:dev && node -e \"console.log('构建完成: dist/bundle.js')\"",
    "release": "node scripts/release.js"
  },
  "keywords": [
    "sillytavern",
    "toolkit",
    "plugin"
  ],
  "author": "YouYou",
  "license": "MIT",
  "devDependencies": {
    "esbuild": "^0.20.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/heis1696/youyou_Toolkit.git"
  }
}
